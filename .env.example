# Copy to .env and adjust. Every variable is optional.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false:
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=attendance.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.com
# DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database ---------------------------------------------------------------
# Default: the local SQLite file db.sqlite3.
# Dedicated PostgreSQL server:
# DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# --- Face images ------------------------------------------------------------
# Where captured face photos are stored:
#   filesystem - face_recognition_data/training_dataset/<username>/*.jpg
#   database   - FaceImage table in the database above (e.g. PostgreSQL)
FACE_IMAGE_STORAGE=filesystem
# FACE_DATA_DIR=/path/to/face_recognition_data

# --- Recognition tuning -----------------------------------------------------
# FACE_CAMERA_INDEX=0
# FACE_SAMPLES_PER_USER=300
# FACE_MATCH_THRESHOLD=0.7
# FACE_MAX_DISTANCE=0.6
# FACE_MIN_HITS=3
